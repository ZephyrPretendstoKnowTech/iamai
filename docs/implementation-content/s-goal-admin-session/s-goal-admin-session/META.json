    "sourceDisplayName": "IAC - GLOBAL – SESSION – Admin Persistence (4 Hours)",
    "sourceState": "enabled",
    "canonicalSemantics": {
      "users": "exact tenant-resolved role population corresponding to the pinned admin-session target; source currently covers the full built-in directory-role set",
      "resources": "All resources",
      "clientAppTypes": [
        "browser"
      ],
      "grantControls": null,
      "sessionControls": {
        "signInFrequency": {
          "isEnabled": true,
          "frequencyInterval": "timeBased",
          "type": "hours",
          "value": 4,
          "authenticationType": "primaryAndSecondaryAuthentication"
        },
        "persistentBrowser": {
          "isEnabled": true,
          "mode": "never"
        }
      },
      "lifecycle": "new client deployment starts Report-only"
    },
    "rule": "Preserve the pinned 4-hour browser session and never-persistent behavior. Do not substitute a generic 12-hour floor or narrow the pinned role population to a model-selected admin subset."
