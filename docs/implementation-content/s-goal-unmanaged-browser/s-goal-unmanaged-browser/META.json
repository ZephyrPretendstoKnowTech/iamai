  "caveats": [
    {
      "id": "sharepoint-ca-side-effect",
      "status": "must-rescan",
      "detail": "Microsoft documents that choosing Allow limited, web-only access on the SharePoint unmanaged-devices page disables previous Conditional Access policies created from that page and creates a new all-users CA policy; customizations are not carried over. IAMAI must stop and rescan after this prerequisite change before mutating CA by stable ID."
    },
    {
      "id": "policy-b-license",
      "status": "conditional",
      "detail": "Policy B uses Conditional Access App Control / cloudAppSecurity blockDownloads and requires the Defender for Cloud Apps dependency. If unavailable, Policy A can still be authored but Policy B is not silently omitted from completion truth."
    }
  ],
