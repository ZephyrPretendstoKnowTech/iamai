    "canonicalSemantics": {
      "sharePointPrerequisite": "organization unmanaged-device setting AllowLimitedAccess, verified separately from CA",
      "policyA": "Office 365 browser policy with the IAMAI-resolved Windows/unmanaged discriminator and applicationEnforcedRestrictions enabled",
      "policyB": "Office 365 outside-trusted/other-platform policy with IAMAI-resolved device filter and cloudAppSecurity blockDownloads; only when Defender for Cloud Apps dependency is licensed/resolved",
      "lifecycle": "CA policies start Report-only; SharePoint prerequisite must be changed and rescanned before CA mutation because Microsoft may replace CA policies created from the SharePoint page"
    },
    "rule": "Preserve the two-policy merged IAMAI step and keep SharePoint/Defender service configuration separate from CA JSON. Never invent stable source GUIDs. After changing the SharePoint unmanaged-device tenant setting, stop and rescan before using any previously resolved CA policy ID."
  },
